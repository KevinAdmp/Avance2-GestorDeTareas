# ─────────────────────────────────────────────────────────────────────────────
# Gestor de Tareas Colaborativo — Variables de entorno
#
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
# Genera un valor seguro con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Base de datos RDS (PostgreSQL) ────────────────────────────────────────────
DB_HOST=<endpoint-de-tu-rds>.rds.amazonaws.com
DB_PORT=5432
DB_NAME=gestortareas
DB_USER=<usuario-maestro>
DB_PASSWORD=<contraseña-maestra>

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=gestor-tareas-adjuntos

# Credenciales del Learner Lab — se renuevan cada vez que inicias sesión en AWS Academy
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# No cambiar en desarrollo local; el docker-compose usa estos valores por defecto
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
TASK_QUEUE=recordatorios
